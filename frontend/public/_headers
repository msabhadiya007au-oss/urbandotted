# Render Static Site response headers
#
# Long-lived cache for hashed CRA bundles (their filename changes on rebuild).
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Do NOT cache index.html — must revalidate every load so new deploys are picked
# up immediately (fixes the 'old UI in one tab, new UI in Incognito' issue).
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
